<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext traffic is disabled by default. Only allow connections to
      Firebase endpoints over TLS. Do not add arbitrary domains here.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebaseapp.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">cloudfunctions.net</domain>
        <domain includeSubdomains="true">google.com</domain>
    </domain-config>
</network-security-config>
